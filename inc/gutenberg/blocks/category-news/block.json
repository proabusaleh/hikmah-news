{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hikmahnews/category-news",
    "version": "1.0.0",
    "title": "Category News",
    "category": "hikmahnews-blocks",
    "icon": "category",
    "description": "Display posts from a specific category.",
    "keywords": ["news", "category", "section"],
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "attributes": {
        "postCount":   { "type": "number", "default": 6 },
        "category":    { "type": "string", "default": "" },
        "columns":     { "type": "number", "default": 3 },
        "showExcerpt": { "type": "boolean", "default": true },
        "showViews":   { "type": "boolean", "default": true },
        "title":       { "type": "string", "default": "Category News" }
    },
    "textdomain": "hikmahnews",
    "editorScript": "hikmahnews-blocks-editor",
    "editorStyle": "hikmahnews-blocks-editor",
    "style": "hikmahnews-main"
}