{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hikmahnews/advertisement",
    "version": "1.0.0",
    "title": "Advertisement",
    "category": "hikmahnews-blocks",
    "icon": "money-alt",
    "description": "Ad placement block for managed ad slots.",
