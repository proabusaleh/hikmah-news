{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hikmahnews/news-list",
    "version": "1.0.0",
    "title": "News List",
    "category": "hikmahnews-blocks",
    "icon": "list-view",
    "description": "Compact list-style news items.",
    "keywords": ["news", "list", "compact", "headlines"],
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "attributes": {
        "postCount":   { "type": "number", "default": 5 },
        "category":    { "type": "string", "default": "" },
        "columns":     { "type": "number", "default": 3 },
        "showExcerpt": { "type": "boolean", "default": true },
        "showViews":   { "type": "boolean", "default": true },
        "title":       { "type": "string", "default": "" }
    },
    "textdomain": "hikmahnews",
    "editorScript": "hikmahnews-blocks-editor",
    "editorStyle": "hikmahnews-blocks-editor",
    "style": "hikmahnews-main"
}