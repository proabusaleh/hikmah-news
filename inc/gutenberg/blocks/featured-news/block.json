{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hikmahnews/featured-news",
    "version": "1.0.0",
    "title": "Featured News",
    "category": "hikmahnews-blocks",
    "icon": "star-filled",
    "description": "Display featured/starred articles.",
    "keywords": ["news", "featured", "starred", "top"],
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "attributes": {
        "postCount":   { "type": "number", "default": 4 },
        "columns":     { "type": "number", "default": 3 },
        "showExcerpt": { "type": "boolean", "default": true },
        "showViews":   { "type": "boolean", "default": true },
        "title":       { "type": "string", "default": "Featured News" }
    },
    "textdomain": "hikmahnews",
    "editorScript": "hikmahnews-blocks-editor",
    "editorStyle": "hikmahnews-blocks-editor",
    "style": "hikmahnews-main"
}